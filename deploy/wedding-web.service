[Unit]
Description=Wedding Ceremony Website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wedding-bot
ExecStart=/opt/wedding-bot/.venv/bin/uvicorn web_app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
